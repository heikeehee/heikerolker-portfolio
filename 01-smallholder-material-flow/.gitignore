# Data — never commit raw or processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Outputs — generated by pipeline, not source files
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# R session files
.DS_Store
*.Rhistory
*.RData
*.nb.html
.Rproj.user/

# Python
__pycache__/
*.pyc
.venv/

session-notes.md
_internal/
